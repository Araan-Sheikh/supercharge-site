{
  "name": "supercharge-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "build": "npm run build:index && next build",
    "dev": "node server.mjs",
    "terminal": "node scripts/terminal-server.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "test:plugins": "tsx --test tests/plugins/*.test.ts",
    "test:plugins:e2e": "playwright test",
    "plugins:setup": "node scripts/setup-plugin-admin.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.1.5",
    "@langchain/openai": "^1.2.0",
    "@orama/orama": "^3.1.16",
    "@orama/plugin-data-persistence": "^3.1.16",
    "@vercel/functions": "^3.10.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.2.4",
    "fumadocs-mdx": "14.1.0",
    "fumadocs-ui": "16.2.4",
    "langchain": "^1.2.0",
    "lit": "^3.3.1",
    "lucide-react": "^0.556.0",
    "next": "^16.0.10",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
