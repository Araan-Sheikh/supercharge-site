# ================================
# LLM Configuration
# ================================

# Choose ONE provider setup below and comment out the other
# ------------------------------------------------

# ===== Option 1: Pollinations / Ollama-compatible (Self-hosted / Free) =====

LLM_BASE_URL=https://gen.pollinations.ai/v1
LLM_API_KEY=plln_pk_your_api_key_here
LLM_MODEL=gemini


# ===== Option 2: OpenAI / OpenAI-compatible Proxies =====
# (Uncomment if you use OpenAI or a proxy like OpenRouter)

# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o

# PayU hosted checkout for /donate. Leave the key blank until you have a merchant account.
# test -> https://test.payu.in   live -> https://secure.payu.in
PAYU_MODE=test
PAYU_KEY=
PAYU_SALT=
NEXT_PUBLIC_SITE_URL=https://superchargeai.in
# After hosting, set the PayU webhook to https://superchargeai.in/api/donate/webhook

# Plugin administration. Set your administrator password.
PLUGIN_PUBLIC_ORIGIN=https://www.superchargeai.in
PLUGIN_ADMIN_KEY=
# Optional independent session secret and private catalog read token.
PLUGIN_SESSION_SECRET=
PLUGIN_CATALOG_READ_TOKEN=
# Vercel Postgres integration supplies POSTGRES_URL or DATABASE_URL automatically.
POSTGRES_URL=
# VPS/local durable SQLite. Keep this outside ephemeral deployment directories.
PLUGIN_DATABASE_PATH=
# Optional Cloudflare D1 backend. Set all three to use D1 instead of SQLite.
CLOUDFLARE_ACCOUNT_ID=
PLUGIN_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
